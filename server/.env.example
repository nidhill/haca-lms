# ─── Core (already in SHO App server) ────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/sho_app
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=https://learn.haca.ac

# ─── Email (Resend — already configured) ──────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@haca.ac

# ─── Cloudflare R2 (new — for video, PDFs, assignment uploads) ────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=haca-lms
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ─── Firebase Cloud Messaging (new) ───────────────────────────────────────────
FCM_SERVER_KEY=your_fcm_server_key

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
