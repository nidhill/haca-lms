# LMS Frontend Environment Variables
# During dev, Vite proxies /api → localhost:5001 automatically.
# In production, set this to your Render backend URL:
VITE_API_URL=https://your-backend.onrender.com/api/lms

# Firebase Cloud Messaging (for push notifications)
VITE_FCM_VAPID_KEY=your_fcm_vapid_key
